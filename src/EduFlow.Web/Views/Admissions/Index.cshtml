@model IReadOnlyList<EduFlow.Web.Models.ReviewApplicationListItemViewModel>
@{ ViewData["Title"] = "Application queue"; }
<h1>Application queue</h1>
@if (Model.Count == 0) { <div class="alert alert-info">There are no applications in this queue.</div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Reference</th><th>Course</th><th>Created</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var a in Model) { <tr><td>@a.Reference</td><td>@a.CourseCode — @a.CourseName</td><td>@a.CreatedUtc.ToLocalTime().ToString("g")</td><td>@a.Status</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@a.ApplicationId">Open</a></td></tr> }</tbody></table></div> }
