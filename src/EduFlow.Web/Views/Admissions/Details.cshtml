@model EduFlow.Web.Models.ReviewApplicationDetailsViewModel
@{ ViewData["Title"] = "Review application"; }
<h1>@Model.Reference</h1><p><strong>@Model.CourseCode — @Model.CourseName</strong></p><p>Status: <strong>@Model.Status</strong></p><h2>Personal statement</h2><p class="white-space-pre-line">@(Model.PersonalStatement ?? "No statement supplied.")</p>
<a class="btn btn-primary" asp-action="Review" asp-route-id="@Model.ApplicationId">Review application</a>
<h2 class="mt-4">History</h2><ul class="list-group">@foreach (var item in Model.StatusHistory) { <li class="list-group-item"><strong>@item.ToStatus</strong> <span class="text-muted">@item.ChangedAtUtc.ToLocalTime().ToString("g")</span>@if (!string.IsNullOrWhiteSpace(item.PublicMessage)) { <div>Public: @item.PublicMessage</div> }@if (!string.IsNullOrWhiteSpace(item.InternalNote)) { <div>Internal: @item.InternalNote</div> }</li> }</ul>
