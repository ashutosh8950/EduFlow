@model EduFlow.Web.Models.ReviewApplicationDetailsViewModel
@{ ViewData["Title"] = "Review application"; }
<h1>@Model.Reference</h1><p><strong>@Model.CourseCode — @Model.CourseName</strong></p><p>Status: <span class="status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></p><h2>Personal statement</h2><p class="white-space-pre-line">@(Model.PersonalStatement ?? "No statement supplied.")</p>
<a class="btn btn-primary" asp-action="Review" asp-route-id="@Model.ApplicationId">Review application</a>
<h2 class="mt-4">History</h2><ul class="list-group">@foreach (var item in Model.StatusHistory) { <li class="list-group-item"><span class="status-badge status-@item.ToStatus.ToString().ToLowerInvariant()">@item.ToStatus</span> <span class="text-muted">@item.ChangedAtUtc.ToLocalTime().ToString("g")</span>@if (!string.IsNullOrWhiteSpace(item.PublicMessage)) { <div class="mt-2">Public: @item.PublicMessage</div> }@if (!string.IsNullOrWhiteSpace(item.InternalNote)) { <div class="mt-1">Internal: @item.InternalNote</div> }</li> }</ul>
