@model IReadOnlyList<EduFlow.Web.Models.StudentApplicationListItemViewModel>
@{ ViewData["Title"] = "My applications"; }
<h1>My applications</h1>
@if (Model.Count == 0) { <div class="alert alert-info">You have not started an application yet.</div> }
else { <div class="table-responsive"><table class="table"><thead><tr><th>Reference</th><th>Course</th><th>Created</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var application in Model) { <tr><td>@application.Reference</td><td>@application.CourseCode — @application.CourseName</td><td>@application.CreatedUtc.ToLocalTime().ToString("g")</td><td>@application.Status</td><td><a class="btn btn-sm btn-outline-primary" asp-action="ApplicationDetails" asp-route-id="@application.ApplicationId">View</a></td></tr> }
</tbody></table></div> }
