@model EduFlow.Web.Models.EditStudentProfileViewModel
@{
    ViewData["Title"] = "Edit profile";
}

<div class="page-heading">
    <p class="eyebrow mb-2">Student account</p>
    <h1 class="mb-2">Edit profile</h1>
    <p class="mb-0">Update the information used for your student account.</p>
</div>

<div class="card profile-card">
    <div class="card-body p-4 p-md-5">
        <form asp-action="EditProfile" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" autocomplete="bday" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="AddressLine" class="form-label"></label>
                    <input asp-for="AddressLine" class="form-control" autocomplete="street-address" />
                    <span asp-validation-for="AddressLine" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" autocomplete="address-level2" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Region" class="form-label"></label>
                    <input asp-for="Region" class="form-control" autocomplete="address-level1" />
                    <span asp-validation-for="Region" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PostalCode" class="form-label"></label>
                    <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
