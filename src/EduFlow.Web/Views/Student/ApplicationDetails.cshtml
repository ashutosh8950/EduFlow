@model EduFlow.Web.Models.StudentApplicationDetailsViewModel
@{ ViewData["Title"] = "Application details"; }
<h1>@Model.Reference</h1><p><strong>@Model.CourseCode — @Model.CourseName</strong></p>
<dl class="row"><dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></dd><dt class="col-sm-3">Submitted</dt><dd class="col-sm-9">@(Model.SubmittedUtc?.ToLocalTime().ToString("g") ?? "Not submitted")</dd></dl>
@if (Model.Status == EduFlow.Application.Domain.AdmissionStatus.Draft)
{
    <a class="btn btn-primary" asp-action="EditApplication" asp-route-id="@Model.ApplicationId">Edit / Resume draft</a>
}
<h2>Personal statement</h2><p class="white-space-pre-line">@(Model.PersonalStatement ?? "No statement saved.")</p>
<h2>Status history</h2>
@if (Model.StatusHistory.Count == 0) { <p class="text-muted">No status changes yet.</p> } else { <ul class="list-group">@foreach (var item in Model.StatusHistory) { <li class="list-group-item"><span class="status-badge status-@item.ToStatus.ToString().ToLowerInvariant()">@item.ToStatus</span> <span class="text-muted">@item.ChangedAtUtc.ToLocalTime().ToString("g")</span>@if (!string.IsNullOrWhiteSpace(item.PublicMessage)) { <div class="mt-2">@item.PublicMessage</div> }</li>}</ul> }
