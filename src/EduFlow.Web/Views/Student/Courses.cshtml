@model IReadOnlyList<CourseListItemViewModel>
@{
    ViewData["Title"] = "Course catalog";
}

<h1 class="h2 mb-1">Course catalog</h1>
<p class="text-secondary mb-4">Browse courses currently available to students.</p>

@if (Model.Count == 0)
{
    <div class="border rounded p-4 text-center">
        <h2 class="h5">No courses are available</h2>
        <p class="text-secondary mb-0">Check back later for active courses.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th scope="col">Code</th><th scope="col">Course</th><th scope="col">Duration</th><th scope="col"><span class="visually-hidden">Details</span></th></tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td class="fw-semibold">@course.Code</td>
                        <td>@course.Name</td>
                        <td>@course.DurationMonths months</td>
                        <td class="text-end"><a asp-action="CourseDetails" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-primary">View details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}