@model EduFlow.Web.Models.EditDraftApplicationViewModel
@{ ViewData["Title"] = "Edit draft application"; }
<a asp-action="ApplicationDetails" asp-route-id="@Model.ApplicationId" class="link-secondary text-decoration-none">Back to application</a>
<h1 class="h2 mt-2">Edit @Model.Reference</h1>
<p class="text-muted">@Model.CourseCode — @Model.CourseName</p>
<form asp-action="EditApplication" method="post">
    <input asp-for="ApplicationId" type="hidden" />
    <input asp-for="Reference" type="hidden" />
    <input asp-for="CourseCode" type="hidden" />
    <input asp-for="CourseName" type="hidden" />
    <input asp-for="RowVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="PersonalStatement" class="form-label"></label>
        <textarea asp-for="PersonalStatement" class="form-control" rows="8"></textarea>
        <span asp-validation-for="PersonalStatement" class="text-danger"></span>
    </div>
    <button class="btn btn-outline-secondary" name="action" value="save">Save changes</button>
    <button class="btn btn-primary" name="action" value="submit">Submit application</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
