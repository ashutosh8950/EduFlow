@model IReadOnlyList<CourseListItemViewModel>
@{
    ViewData["Title"] = "Course management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Course management</h1>
        <p class="text-secondary mb-0">Manage the courses available in EduFlow.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create course</a>
</div>

@if (Model.Count == 0)
{
    <div class="border rounded p-4 text-center">
        <h2 class="h5">No courses yet</h2>
        <p class="text-secondary">Create the first course to make it available for students.</p>
        <a asp-action="Create" class="btn btn-primary">Create course</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Course</th>
                    <th scope="col">Duration</th>
                    <th scope="col">Status</th>
                    <th scope="col">Updated</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td class="fw-semibold">@course.Code</td>
                        <td>@course.Name</td>
                        <td>@(course.DurationMonths) months</td>
                        <td><span class="badge @(course.IsActive ? "text-bg-success" : "text-bg-secondary")">@(course.IsActive ? "Active" : "Inactive")</span></td>
                        <td>@((course.UpdatedUtc ?? course.CreatedUtc).ToString("yyyy-MM-dd"))</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-primary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}