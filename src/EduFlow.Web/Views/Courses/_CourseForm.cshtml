@model CourseFormViewModel
<form asp-action="@ViewData["FormAction"]" asp-route-id="@ViewData["CourseId"]" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" maxlength="20" autocomplete="off" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="150" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DurationMonths" class="form-label"></label>
        <input asp-for="DurationMonths" class="form-control" type="number" min="1" max="32767" />
        <span asp-validation-for="DurationMonths" class="text-danger"></span>
    </div>
    @if (ViewData["FormAction"]?.ToString() == "Create")
    {
        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    }
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@ViewData["SubmitLabel"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}